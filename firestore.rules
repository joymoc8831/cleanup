rules_version = '2';

// スカッドボード用の最小構成ルール。
// このアプリにはログイン機能がないため、「アプリのURLを知っている人は
// 名鑑・チームボードを読み書きできる」という前提のルールです。
// Firebaseコンソール → Firestore Database →「ルール」タブに、
// この内容をそのまま貼り付けて「公開」してください。

service cloud.firestore {
  match /databases/{database}/documents {

    // 名鑑（roster）とチームボード（boards）だけ読み書きを許可します。
    match /roster/{docId} {
      allow read, write: if true;
    }
    match /boards/{docId} {
      allow read, write: if true;
    }

    // それ以外のパスは念のため拒否します。
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
